    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^24.10.1",
    "bun-types": "^1.3.6",
    "eslint": "^9.39.2",
    "eslint-plugin-perfectionist": "^4.15.1",
    "gray-matter": "^4.0.3",
    "hono": "^4.9.2",
    "prettier": "^3.8.1",
